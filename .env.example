# Optional. When set, uploads (web form and CLI) require this token. Empty = open uploads.
# Generate one with: openssl rand -hex 24
FSEND_TOKEN=

# Brute-force protection: after N wrong tokens an IP is locked out for M minutes.
FSEND_AUTH_MAX_FAILS=5
FSEND_AUTH_LOCKOUT_MINUTES=15

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For,
# so the lockout applies to the real client IP instead of the proxy.
FSEND_TRUST_PROXY=false

# Host user the container runs as, so ./data stays owned by you (`id -u`, `id -g`).
FSEND_UID=1000
FSEND_GID=1000

# Host port to expose
FSEND_PORT=8080

# Length of the random file id in URLs (/{id}/{filename}). Grows automatically on collisions.
FSEND_ID_LENGTH=3

# Max size per file (K, M, G, T suffixes)
FSEND_MAX_UPLOAD_SIZE=10G

# Retention in days (decimals allowed, e.g. 0.5 = 12 hours)
FSEND_DEFAULT_DAYS=3
FSEND_MAX_DAYS=30

# How often expired files are swept, in seconds
FSEND_CLEANUP_INTERVAL=600

# Log level
RUST_LOG=fsend=info,tower_http=warn
