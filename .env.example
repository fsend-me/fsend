# Optional. When set, uploads (web form and CLI) require this token. Empty = open uploads.
# Generate one with: openssl rand -hex 24
FSEND_TOKEN=

# Brute-force protection: after N wrong tokens an IP is locked out for M minutes.
FSEND_AUTH_MAX_FAILS=5
FSEND_AUTH_LOCKOUT_MINUTES=15
# Server-wide budget of wrong tokens per lockout window. When used up, uploads pause
# for clients that haven't uploaded successfully in the last 24h. 0 = off.
FSEND_AUTH_GLOBAL_MAX_FAILS=100

# Requests for missing links allowed per client in 10 minutes before a 10-minute block
# (stops scanning short ids). 0 = off.
FSEND_NOT_FOUND_MAX=30

# Behind a reverse proxy (nginx, Caddy, Traefik...)? Set this to true, and make the proxy
# send X-Forwarded-For. Otherwise every visitor shares the proxy's IP and one rate limit:
# bots hitting a few dozen missing URLs then block downloads for everyone for 10 minutes.
# fsend logs a warning when it sees X-Forwarded-For while this is false.
# Keep false when clients connect to fsend directly (the header could be forged).
FSEND_TRUST_PROXY=false

# Host user the container runs as, so ./data stays owned by you (`id -u`, `id -g`).
FSEND_UID=1000
FSEND_GID=1000

# Host port to expose
FSEND_PORT=8080

# Length of the random file id in URLs (/{id}/{filename}). Grows automatically on collisions.
FSEND_ID_LENGTH=3

# Max size per file (K, M, G, T suffixes)
FSEND_MAX_UPLOAD_SIZE=10G

# Retention in days (decimals allowed, e.g. 0.5 = 12 hours)
FSEND_DEFAULT_DAYS=3
FSEND_MAX_DAYS=30

# How often expired files are swept, in seconds
FSEND_CLEANUP_INTERVAL=600

# Log level
RUST_LOG=fsend=info,tower_http=warn
